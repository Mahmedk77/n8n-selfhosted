# Copy to deploy/.env on the server and fill in. chmod 600 deploy/.env
# Never commit the real file.

# Public domain n8n is served on. DNS A record must point at the VPS first.
N8N_DOMAIN=

# Postgres credentials (used by both the postgres and n8n services).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Encrypts credentials stored in n8n. Generate once (openssl rand -hex 32).
# If lost or changed, every saved credential becomes unreadable.
# Back it up SEPARATELY from the database dumps.
N8N_ENCRYPTION_KEY=
